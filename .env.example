# Copy to .env. Offline demo mode works without configuring any credentials.
OFFLINE_MODE_DEFAULT=true
DATABASE_PATH=data/outreach.sqlite3
APP_TIMEZONE=UTC
MAX_DAILY_SENDS=15

# Optional public web search (Serper provider); live calls occur only when offline mode is disabled.
SEARCH_PROVIDER=serper
SERPER_API_KEY=your_serper_api_key_here

# Optional OpenAI-compatible chat completions API for structured scoring and outreach generation.
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
